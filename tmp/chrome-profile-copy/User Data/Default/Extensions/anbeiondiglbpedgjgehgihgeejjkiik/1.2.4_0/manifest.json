   "icons": {
      "128": "images/icon128.png",
      "24": "images/icon24.png",
      "48": "images/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "TestCraft",
   "permissions": [ "activeTab", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.2.4"
}
