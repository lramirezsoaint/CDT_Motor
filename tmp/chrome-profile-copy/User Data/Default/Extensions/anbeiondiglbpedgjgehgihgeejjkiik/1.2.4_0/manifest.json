{
   "action": {
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "scripts/service.js",
      "type": "module"
   },
   "content_scripts": [ {
      "css": [ "styles/styles.css" ],
      "js": [ "scripts/content.js" ],
      "matches": [ "\u003Call_urls>" ]
   } ],
