# ==================================================
# AMBIENTE OBJETIVO
# ==================================================

# URL base del Motor de Distribucion usado por los tests.
MOTOR_BASE_URL=https://distribuciongastosdev.pacificotest.com.pe/distribuciones/

# Credenciales Admin.
# No subir valores reales.
MOTOR_USERNAME=
MOTOR_PASSWORD=

# Credenciales Gestor de Gastos Financieros.
# No subir valores reales.
MOTOR_GESTOR_GF_USERNAME=
MOTOR_GESTOR_GF_PASSWORD=

# ==================================================
# CONFIGURACION OPCIONAL DE PLAYWRIGHT
# ==================================================

PW_WORKERS=1
PW_SLOWMO=0
HEADLESS=true

# ==================================================
# CONFIGURACION GENERAL DE INCIDENTES
# ==================================================

# Proveedor externo donde se administraran los incidentes.
# Valores permitidos:
#   none   = no usar proveedor externo
#   azure  = Azure DevOps
#   jira   = Jira
#   trello = Trello
INCIDENT_PROVIDER=azure

# Permite la creacion automatica de incidentes.
# Solo tiene efecto cuando:
#   INCIDENT_MODE=create
#   el caso es BUG_AUTO
#   confidence=HIGH
#   el provider permite creacion
#
# Default seguro: false
AUTO_CREATE_INCIDENTS=false

# Modo de operacion:
#   preview = genera diagnostico/reporte pero NO crea incidentes
#   create  = permite creacion si tambien se cumplen los gates de seguridad
#
# Default seguro: preview
INCIDENT_MODE=preview

# ==================================================
# EVIDENCIAS GENERALES DE INCIDENTES
# ==================================================

# Habilita envio de evidencias al provider.
# Incluye screenshot y trace cuando esten disponibles.
INCIDENT_ATTACH_EVIDENCE=false

# Habilita envio de video.
# Requiere tambien INCIDENT_ATTACH_EVIDENCE=true.
INCIDENT_ATTACH_VIDEO=false

# Tamano maximo permitido para video antes de omitir el upload.
INCIDENT_MAX_VIDEO_MB=50

# Timeout maximo para requests HTTP de providers.
INCIDENT_REQUEST_TIMEOUT_MS=15000

# ==================================================
# LOGGING Y DEBUG DE INCIDENTES
# ==================================================

# false:
#   consola resumida
#
# true:
#   muestra informacion tecnica adicional de clasificacion,
#   requests sanitizados, dedup, attachments y lifecycle.
#
# Nunca debe imprimir tokens, PATs ni Authorization.
DEBUG_INCIDENTS=false

# ==================================================
# AZURE DEVOPS
# ==================================================

# Organizacion y proyecto de Azure DevOps destino.
# Nunca poner valores reales sensibles en este archivo.
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PROJECT=

# Personal Access Token para Azure DevOps.
# Tratar como secreto. Nunca versionar este valor.
AZURE_DEVOPS_PAT=

# Ejecuta llamadas de creacion de Azure con validateOnly cuando aplica.
AZURE_DEVOPS_VALIDATE_ONLY=false

# Compatibilidad legacy para evidencias Azure.
# Si INCIDENT_ATTACH_EVIDENCE esta definido, tiene prioridad.
AZURE_DEVOPS_ATTACH_EVIDENCE=false

# Compatibilidad legacy para video Azure.
# Si INCIDENT_ATTACH_VIDEO esta definido, tiene prioridad.
AZURE_DEVOPS_ATTACH_VIDEO=false

# Compatibilidad legacy para tamano maximo de video Azure.
# Si INCIDENT_MAX_VIDEO_MB esta definido, tiene prioridad.
AZURE_DEVOPS_MAX_VIDEO_MB=50

# Compatibilidad legacy para timeout HTTP Azure.
# Si INCIDENT_REQUEST_TIMEOUT_MS esta definido, tiene prioridad.
AZURE_DEVOPS_REQUEST_TIMEOUT_MS=15000

# Estados cerrados usados por dedup en Azure DevOps.
# Separar multiples valores con coma. Si queda vacio se usan defaults internos.
AZURE_DEVOPS_CLOSED_STATES=

# ==================================================
# JIRA
# ==================================================

# URL raiz de Jira Cloud.
# Ejemplo:
# https://empresa.atlassian.net
JIRA_BASE_URL=

# Key del proyecto Jira.
# Ejemplo:
# SCRUM
JIRA_PROJECT_KEY=

# Correo de la cuenta utilizada para Basic Auth.
JIRA_EMAIL=

# API Token de Atlassian.
# No usar contrasena.
# Nunca versionar este valor.
JIRA_API_TOKEN=

# Tipo de issue que se creara.
# Debe coincidir exactamente con un issue type disponible en el proyecto.
# Ejemplos: Bug, Error, Task.
JIRA_ISSUE_TYPE=Error

# true:
#   permite validacion/dedup read-only pero NO creacion real.
# false:
#   permite creacion solo si tambien se cumplen los gates generales.
JIRA_VALIDATE_ONLY=true

# ==================================================
# TRELLO
# ==================================================

# URL base de la API de Trello.
TRELLO_BASE_URL=https://api.trello.com/1

# API Key de la app/Power-Up de Trello.
TRELLO_API_KEY=

# Token autorizado del usuario.
# Tratar como secreto.
TRELLO_TOKEN=

# ID o shortLink del board destino.
TRELLO_BOARD_ID=

# ID de la lista donde se crearan las cards.
TRELLO_LIST_ID=

# true:
#   solo validacion/dedup.
# false:
#   permite creacion real si los gates generales tambien lo permiten.
TRELLO_VALIDATE_ONLY=true

# Limite maximo por attachment.
# Default conservador para Trello Free: 10 MB.
# Puede ajustarse segun el plan.
TRELLO_MAX_ATTACHMENT_MB=10

# ==================================================
# HARNESSES JIRA - EJECUCION MANUAL CONTROLADA
# ==================================================

# Flags temporales para scripts manuales de Jira.
# NO deben quedar true permanentemente.
# No forman parte del flujo normal de Playwright.
JIRA_RUN_REAL_VALIDATION=false
JIRA_RUN_REAL_DEDUP_TEST=false
JIRA_RUN_REAL_CREATE=false
JIRA_RUN_REAL_ATTACHMENT_TEST=false
JIRA_TEST_ISSUE_KEY=

# ==================================================
# HARNESSES TRELLO - EJECUCION MANUAL CONTROLADA
# ==================================================

# Flags temporales para scripts manuales de Trello.
# NO deben quedar true permanentemente.
# No forman parte del flujo normal de Playwright.
TRELLO_RUN_REAL_AUTH_TEST=false
TRELLO_RUN_REAL_VALIDATION=false
TRELLO_RUN_REAL_DEDUP_TEST=false
TRELLO_RUN_REAL_CREATE=false
TRELLO_RUN_REAL_ATTACHMENT_TEST=false
TRELLO_RUN_LISTS=false
TRELLO_TEST_CARD_ID=

# ==================================================
# CONFIGURACION PARA ELIMINACION DE DISTRIBUCIONES QA
# ==================================================

E2E_DISTRIBUCION_DELETE_TARGET=
