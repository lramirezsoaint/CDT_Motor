{
  "name": "distribucion-playwright-framework",
  "version": "2.0.0",
  "private": true,
  "description": "Base refactorizada de Playwright para Motor de Distribucion",
  "type": "commonjs",
  "scripts": {
    "test": "node --experimental-strip-types scripts/run-all-with-history.ts",
    "test:raw": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "test:bloque2": "playwright test tests/e2e/bloque-2 --grep @bloque2 --workers=1",
    "test:bloque2:chromium": "playwright test tests/e2e/bloque-2 --project=chromium --grep @bloque2 --workers=1",
    "test:bloque2:gestor": "playwright test tests/e2e/bloque-2 --project=chromium-gestor --grep @bloque2 --workers=1",
    "test:bloque2:gestorGasto": "playwright test tests/e2e/bloque-2 --project=chromium-gestor-gasto --workers=1",
    "test:block1:sequential": "node --experimental-strip-types scripts/run-block1-implemented-sequential.ts",
    "test:all:history": "node --experimental-strip-types scripts/run-all-with-history.ts",
    "report": "playwright show-report",
    "report:executive": "node --experimental-strip-types scripts/generate-executive-report.ts",
    "cases:bd1": "node scripts/export-bd1-case-matrix.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.0.9",
    "csv-parse": "^6.1.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "xlsx": "^0.18.5"
  }
}
