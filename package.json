{
  "name": "distribucion-playwright-framework",
  "version": "2.0.0",
  "private": true,
  "description": "Base refactorizada de Playwright para Motor de Distribucion",
  "type": "commonjs",
  "scripts": {
    "test": "node --experimental-strip-types scripts/runners/run-all-with-history.ts",
    "test:raw": "playwright test",
    "test:login": "playwright test --grep @login",
    "test:distribucion": "playwright test --grep @distribucion",
    "test:upload:valido": "playwright test --grep @upload_valido",
    "test:upload:invalido": "playwright test --grep @upload_invalido",
    "test:procesos": "playwright test --grep @procesos",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "test:bloque1": "playwright test tests/e2e/bloque-1 --project=chromium --workers=1",
    "test:bloque2": "playwright test tests/e2e/bloque-2 --project=chromium-gestorGT --workers=1",
    "test:bloque2:gestorGT": "playwright test tests/e2e/bloque-2 --project=chromium-gestorGT --workers=1",
    "test:bloque3": "playwright test tests/e2e/bloque-3 --project=chromium-gestorGF --workers=1",
    "test:bloque3:gestorGF": "playwright test tests/e2e/bloque-3 --project=chromium-gestorGF --workers=1",
    "test:bloque5": "playwright test tests/e2e/bloque-5 --project=chromium-gestorAM --workers=1",
    "test:bloque5:gestorAM": "playwright test tests/e2e/bloque-5 --project=chromium-gestorAM --workers=1",
    "test:block1:sequential": "node --experimental-strip-types scripts/runners/run-block1-implemented-sequential.ts",
    "test:all:history": "node --experimental-strip-types scripts/runners/run-all-with-history.ts",
    "test:by-dependency": "npx tsx scripts/runners/run-by-dependency.ts",
    "audit:tags": "node scripts/audit-tags.cjs",
    "report": "playwright show-report",
    "report:executive": "node --experimental-strip-types scripts/reports/generate-executive-report.ts",
    "cases:bd1": "node scripts/generators/export-bd1-case-matrix.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.0.9",
    "csv-parse": "^6.1.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "xlsx": "^0.18.5"
  }
}
